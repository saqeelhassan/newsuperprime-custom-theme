+}
+
+/* ── 15. Footer columns ───────────────────────────────────────────────── */
+.clinox-footer-widget ul li a { padding-inline-start: 0; padding-inline-end: 18px; }
+.clinox-footer-widget ul li a::before { left: auto; right: 0; }
+
+/* ── 16. Mobile menu ─────────────────────────────────────────────────── */
+.mobile_menu_content { left: auto; right: 0; transform: translateX(100%); }

+}
+@media screen and (max-width: 1024px) {
+    .header-navigation-content .main-navigation li {
+        margin-right: 0;
+        margin-left: 40px;
+    }
+}
+
+/* ── 21. Promo / CTA section ────────────────────────────────────────────── */
+
+/* Wrapper: reverse so button sits on LEFT, أو+phones appear to its RIGHT */
